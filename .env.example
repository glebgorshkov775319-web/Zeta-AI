# Create an API key with a provider that offers a free inference tier.
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Keep the default router, or replace with a specific model ID listed by your provider.
OPENROUTER_MODEL=openrouter/free
# Optional public app URL, used only for provider attribution headers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
